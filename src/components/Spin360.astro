---
import { spinFrames } from '../data/consignatarias';
import { url } from '../lib/paths';
interface Props { label: string; autoplay?: boolean }
const { label, autoplay = false } = Astro.props;
// Nombre de cada vista, en el mismo orden de spinFrames (de frente, girando por el lado izquierdo).
const views = ['Frente', '3/4 frontal', 'Lateral', '3/4 trasera', 'Atrás', '3/4 trasera', 'Lateral', '3/4 frontal'];
const start = 1;
---
<div class="spin" data-spin data-autoplay={autoplay ? 'true' : undefined} data-start={start}>
  <div class="spin-stage" data-spin-stage tabindex="0" role="slider" aria-label={`Vista 360° de ${label}. Usa las flechas para girar.`} aria-valuemin="0" aria-valuemax="359" aria-valuenow={start * 45} aria-valuetext={views[start]}>
    {spinFrames.map((src, i) => <img src={url(`images/${src}`)} width="1200" height="720" alt={i === start ? label : ''} loading={i === start ? 'eager' : 'lazy'} decoding="async" draggable="false" data-spin-frame style={i === start ? 'opacity:1' : undefined}/>)}
    <span class="spin-badge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 6c5 0 9 1.8 9 4s-4 4-9 4-9-1.8-9-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="m6 12-3-2 3-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>360°</span>
    <span class="spin-hint" data-spin-hint aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 12h8m0 0-3-3m3 3-3 3M8 12l3-3m-3 3 3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="spin-hint-mouse">Arrastra para girar</span><span class="spin-hint-touch">Desliza para girar</span></span>
  </div>
  <button type="button" class="spin-full" data-spin-full aria-label="Ver en pantalla completa"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <div class="spin-views" role="group" aria-label="Vistas del carro">
    {spinFrames.map((src, i) => <button type="button" class="spin-view" data-spin-view={i} aria-pressed={i === start ? 'true' : 'false'}><img src={url(`images/${src}`)} width="1200" height="720" alt="" loading="lazy" decoding="async"/><span>{views[i]}</span></button>)}
  </div>
</div>
