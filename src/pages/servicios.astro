---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { url } from '../lib/paths';

const services = [
  { title: 'Diseño gráfico', copy: 'Ideas que se ven y piezas que piden otra mirada.' },
  { title: 'Branding', copy: 'Marcas con voz, carácter y una forma propia de aparecer.' },
  { title: 'Diseño web', copy: 'Experiencias digitales claras, útiles y con ganas de recorrer.' },
  { title: 'Code Vibe', copy: 'Código con pulso para que cada interacción se sienta viva.' },
  { title: 'IA', copy: 'Nuevas herramientas para imaginar, probar y producir mejor.' },
  { title: 'Editorial', copy: 'Historias ordenadas para que leer también sea una experiencia.' },
  { title: 'SEO', copy: 'Estrategia para aparecer cuando alguien sale a buscarte.' },
  { title: 'Social Media', copy: 'Contenido con intención para conversaciones que sí importan.' },
];
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios creativos de Indigo Estudio',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem', position: index + 1,
    item: { '@type': 'Service', name: service.title, description: service.copy, provider: { '@id': `${site.url}/#organization` }, areaServed: 'Colombia' },
  })),
};
---
<Layout title="Servicios de branding, diseño gráfico y web | Indigo" description="Branding, diseño gráfico, diseño web, editorial, SEO e inteligencia artificial desde Colombia. Ideas con estrategia, carácter y una forma propia de verse." pageType="CollectionPage" imageAlt="Aplicaciones de identidad visual creadas por Indigo Estudio" schema={serviceSchema}>
  <main id="contenido" class="services-page">
    <section class="services-page-hero" data-page-theme="light" aria-labelledby="services-page-title">
      <div class="services-page-top mono"><span>01 / SERVICIOS</span><span>DE LA IDEA A LA CALLE.</span></div>
      <div class="services-page-intro" data-reveal>
        <p>EN RESUMEN</p>
        <h1 id="services-page-title"><span>Hacemos marcas</span><span>y las hacemos</span><span class="services-visible">visibles.</span></h1>
      </div>
      <div class="services-type-board" aria-label="Servicios de Indigo">
        {services.map((service, index) => (
          <article class="services-type-item" data-service-panel style={`--service-order:${index}`}>
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <button type="button" aria-label={`Abrir servicio: ${service.title}`} aria-expanded="false">
              <strong class="services-type-vertical">{service.title}</strong>
              <span class="services-type-open">
                <small class="mono">LO HACEMOS CON TODA.</small>
                <strong>{service.title}</strong>
                <em>{service.copy}</em>
              </span>
            </button>
          </article>
        ))}
      </div>
    </section>

    <section class="portfolio-scene services-portfolio" data-page-theme="dark" data-project-carousel data-carousel-index="0" aria-labelledby="services-portfolio-title" aria-roledescription="carrusel">
      <div class="portfolio-head mono">
        <span>02 / PROYECTOS</span>
        <h2 id="services-portfolio-title">ASÍ SE VE LO QUE HACEMOS.</h2>
        <a href={url('proyectos/')}>VER TODOS</a>
      </div>
      <div class="portfolio-viewport">
        <div class="portfolio-track" data-carousel-track>
          {projects.map((project, index) => (
            <article class:list={['portfolio-card', { 'is-active': index === 0 }]} data-carousel-slide data-project={project.slug} style={`--project-color:${project.color}`}>
              <div class="portfolio-card-head">
                <span class="mono">{String(index + 1).padStart(2, '0')} / {project.category}</span>
                <h3>{project.name}</h3>
                <span class="mono">{project.discipline}</span>
              </div>
              <a class="portfolio-card-link" href={url(`proyectos/${project.slug}/`)} tabindex={index === 0 ? 0 : -1} aria-label={`Ver proyecto ${project.name}`}>
                <img src={url(`images/${project.image}`)} width={project.image.startsWith('projects/') ? 1800 : 1536} height={project.image.startsWith('projects/') ? 1200 : 1024} alt={project.alt} loading="lazy" decoding="async"/>
                <span class="portfolio-shade" aria-hidden="true"></span>
                <span class="portfolio-card-copy"><strong>{project.title}</strong><span>{project.caption}</span></span>
              </a>
            </article>
          ))}
        </div>
      </div>
      <div class="portfolio-foot">
        <p class="mono" aria-live="polite"><span data-carousel-current>01</span> / {String(projects.length).padStart(2, '0')}</p>
        <span class="portfolio-progress" aria-hidden="true"><i data-carousel-progress></i></span>
        <p class="mono">SCROLL PARA RECORRER</p>
      </div>
    </section>

    <section id="contacto" class="scene contact services-contact" data-page-theme="light" aria-labelledby="services-contact-title">
      <div class="section-label mono"><span>03 / EMPIEZA ALGO BUENO</span><span>UNA CONVERSACIÓN BASTA.</span></div>
      <p class="contact-pre">¿Tienes una idea?</p>
      <h2 id="services-contact-title"><button data-brief type="button">HAGÁMOSLE</button></h2>
      <div class="contact-bottom">
        <div><a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a><a class="contact-whatsapp" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp · +57 319 209 9069</a></div>
        <button class="pill pill-dark" data-brief type="button">Cuéntanos tu idea</button>
      </div>
      <footer class="footer"><img src={url('images/indigo-logo.svg')} alt="Indigo Estudio Creativo" width="854" height="296"/><span class="mono">© {new Date().getFullYear()} INDIGO ESTUDIO<br/>HECHO CON GANAS.</span><span class="footer-legal mono"><button type="button" data-cookie-settings>COOKIES</button><a href={url('privacidad/')}>PRIVACIDAD</a></span><a href="#contenido" class="mono">VOLVER ARRIBA</a></footer>
    </section>
  </main>
</Layout>
